# Credentials FTP pour déployer le thème vers alliancegroupe-inc.com
#
# UTILISATION :
#   1. Copie ce fichier en `deploy/.env` (sans .example)
#   2. Remplace les 4 valeurs ci-dessous par les vraies
#   3. Lance `bash deploy/deploy.sh` ou double-clique `deploy/deploy.bat`
#
# IMPORTANT :
#   - Ce fichier `.env` est dans .gitignore — il ne sera jamais commit
#   - Tes identifiants restent sur ta machine uniquement

# Hôte FTP o2switch (généralement ftpXXX.o2switch.net)
FTP_HOST=ftpXX.o2switch.net

# Identifiant FTP (souvent ton nom de compte cPanel)
FTP_USER=ton-identifiant-ftp

# Mot de passe FTP
FTP_PASS=ton-mot-de-passe-ftp

# Chemin sur le serveur jusqu'au dossier themes WordPress
# Sur o2switch c'est typiquement : /home/USER/public_html/wp-content/themes
# OU /www/wp-content/themes selon ta config
FTP_PATH=/home/USER/public_html/wp-content/themes
